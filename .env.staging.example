# Copy these values into the separate staging Vercel project's Environment Variables.
# Use the SAME Supabase URL and public anon key already used by P6 Forms.
# Never put a service-role key in VITE_* variables: these are public browser values.
VITE_APP_MODE=staging
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_EXISTING_PUBLIC_ANON_KEY

# Optional endpoint overrides. Omit to use the existing sequence endpoints.
# 151 always uses the existing invoke-webhook-151 Edge Function with the anon key.
# VITE_STAGING_WEBHOOK_149_URL=https://your-n8n-host/webhook/your-id
# VITE_STAGING_WEBHOOK_149B_URL=https://your-n8n-host/webhook/your-id
# VITE_STAGING_WEBHOOK_152_URL=https://your-n8n-host/webhook/your-id
# VITE_STAGING_WEBHOOK_150_URL=https://your-n8n-host/webhook/your-id
